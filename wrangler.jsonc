{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "world-daylight-atlas",
  "account_id": "0965b107b5f66f95ed3460d1850d0828",
  "compatibility_date": "2026-10-16",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "mytest.ccwu.cc", "custom_domain": true }
  ]
}
